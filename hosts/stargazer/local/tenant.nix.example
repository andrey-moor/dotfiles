# Copy to tenant.nix (gitignored) and fill in. Never commit tenant.nix --
# this repository is public.
#
# IMPORTANT: a gitignored file is invisible to a `git+file:` or `github:`
# flake reference. `nixos-rebuild switch --flake path:/home/andreym/dotfiles#stargazer`
# (note `path:`) copies the working tree verbatim and does see it; the plain
# `github:andrey-moor/dotfiles#stargazer` reference used by the installer and
# by system.autoUpgrade does not, and himmelblau stays disabled with a
# build-time warning in that case. See hosts/stargazer/tenant.nix.
{
  # Entra tenant primary domain -- the domain half of the sign-in UPN.
  domain = "CHANGE-ME.example.com";

  # Entra tenant GUID, pinned per-domain so discovery cannot wander.
  tenantId = "00000000-0000-0000-0000-000000000000";

  # The UPN local user `andreym` authenticates as.
  upn = "CHANGE-ME@CHANGE-ME.example.com";
}
