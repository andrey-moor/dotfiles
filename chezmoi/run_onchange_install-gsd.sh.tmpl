#!/bin/bash
# Get Shit Done (GSD) installer -- redux fork (open-gsd org)
# https://github.com/open-gsd/get-shit-done-redux
#
# Triggered by changes to .gsd-version. Installs GSD into ~/.claude/ via the
# @opengsd/get-shit-done-redux npm package (the active maintained branch
# after get-shit-done-cc was abandoned).
#
# gsd-version hash: {{ include ".gsd-version" | sha256sum }}

set -euo pipefail

GSD_VERSION="{{ include ".gsd-version" | trim }}"

if ! command -v npx &>/dev/null; then
    echo "ERROR: npx not found. Install Node.js to enable GSD installation."
    exit 1
fi

echo "Installing GSD v${GSD_VERSION}..."

# --claude --global: install into ~/.claude/. Other runtimes (codex, gemini,
# opencode) are installed manually via the same package + runtime flag.
npx -y "@opengsd/get-shit-done-redux@${GSD_VERSION}" --claude --global

# Verify installation succeeded
VERSION_FILE="{{ .chezmoi.homeDir }}/.claude/get-shit-done/VERSION"
if [[ ! -f "$VERSION_FILE" ]]; then
    echo "ERROR: GSD installation failed (VERSION file missing)."
    exit 1
fi

echo "GSD v${GSD_VERSION} installed successfully."
echo "  Version: $(cat "$VERSION_FILE")"
echo "  Agents:  $(ls "{{ .chezmoi.homeDir }}/.claude/agents/gsd-"*.md 2>/dev/null | wc -l | tr -d ' ') files"
