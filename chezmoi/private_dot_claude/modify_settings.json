{{- /* chezmoi:modify-template */ -}}
{{- $data := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $data = fromJson .chezmoi.stdin -}}
{{- end -}}

{{- /* ── Portable scalar settings (authoritative — always set) ── */ -}}
{{- $data = setValueAtPath "alwaysThinkingEnabled" true $data -}}
{{- $data = setValueAtPath "effortLevel" "high" $data -}}

{{- /* ── Environment variables (additive — don't override existing) ── */ -}}
{{- $env := dict -}}
{{- if hasKey $data "env" -}}
{{-   $env = index $data "env" -}}
{{- end -}}
{{- /* Force full path: bare "bash" propagates to SHELL=bash in subprocess  */ -}}
{{- /* envs, which breaks OpenSSH 10.2 Match exec clauses that resolve $SHELL */ -}}
{{- /* via execvp (no PATH lookup). /usr/bin/bash exists on macOS + Linux.   */ -}}
{{- $_ := set $env "CLAUDE_CODE_SHELL" "/usr/bin/bash" -}}
{{- $_ := set $data "env" $env -}}

{{- /* ── Plugins (additive — add missing, don't override existing) ── */ -}}
{{- $plugins := dict -}}
{{- if hasKey $data "enabledPlugins" -}}
{{-   $plugins = index $data "enabledPlugins" -}}
{{- end -}}

{{- /* Remove deprecated plugins */ -}}
{{- $_ := unset $plugins "playwright@claude-plugins-official" -}}
{{- $_ := unset $plugins "sentrux@sentrux" -}}

{{- $desired := dict
      "frontend-design@claude-plugins-official" true
      "code-review@claude-plugins-official" true
      "agent-browser@agent-browser" true
      "sentrux@sentrux-marketplace" true
      "document-skills@anthropic-agent-skills" true
      "example-skills@anthropic-agent-skills" true
      "context7@claude-plugins-official" true
      "supabase@claude-plugins-official" true
      "swift-lsp@claude-plugins-official" true
      "skill-creator@claude-plugins-official" true
      "andrej-karpathy-skills@karpathy-skills" true
-}}
{{- range $key, $val := $desired -}}
{{-   if not (hasKey $plugins $key) -}}
{{-     $_ := set $plugins $key $val -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $data "enabledPlugins" $plugins -}}

{{- /* ── Marketplaces (additive — add missing, don't override existing) ── */ -}}
{{- $markets := dict -}}
{{- if hasKey $data "extraKnownMarketplaces" -}}
{{-   $markets = index $data "extraKnownMarketplaces" -}}
{{- end -}}
{{- $desiredMarkets := dict
      "agent-browser" (dict "source" (dict "source" "github" "repo" "vercel-labs/agent-browser"))
      "anthropic-agent-skills" (dict "source" (dict "source" "github" "repo" "anthropics/skills"))
      "claude-plugins-official" (dict "source" (dict "source" "github" "repo" "anthropics/claude-plugins-official"))
      "sentrux-marketplace" (dict "source" (dict "source" "github" "repo" "sentrux/sentrux"))
      "karpathy-skills" (dict "source" (dict "source" "github" "repo" "forrestchang/andrej-karpathy-skills"))
-}}
{{- range $key, $val := $desiredMarkets -}}
{{-   if not (hasKey $markets $key) -}}
{{-     $_ := set $markets $key $val -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $data "extraKnownMarketplaces" $markets -}}

{{- /* ── MCP servers: managed via run_onchange_install-mcp.sh, not here ── */ -}}
{{- /* User-scoped MCP servers live in ~/.claude.json, not settings.json  */ -}}
{{- $_ := unset $data "mcpServers" -}}

{{- $data | toPrettyJson }}
