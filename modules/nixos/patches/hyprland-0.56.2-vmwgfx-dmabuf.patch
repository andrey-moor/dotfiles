Hyprland 0.56.2: release vmwgfx surface handles during linux-dmabuf import.

On vmwgfx, drmPrimeFDToHandle returns a TTM surface handle. DRM_IOCTL_GEM_CLOSE
rejects that handle with EINVAL, so Hyprland treats every GPU client buffer as
invalid. Clients then fail with "invalid arguments for wl_surface.attach".
This patch retries the release with DRM_VMW_UNREF_SURFACE, and only on vmwgfx.

Source: https://github.com/ClaireDuSoleil/hyprland-vmware-fix
  patches/hyprland-0.56.2-vmwgfx-dmabuf.patch at commit 2ccd2bebb821 (BSD-3-Clause)
Discussion: https://github.com/hyprwm/Hyprland/discussions/12966
Status 2026-09-14: not merged upstream. Drop this file when Hyprland ships a fix.
Reviewed 2026-09-14: ioctl 10 and the argument struct match drm_vmw_surface_arg
in include/uapi/drm/vmwgfx_drm.h. The fallback runs only after GEM_CLOSE fails.

diff --git a/src/protocols/LinuxDMABUF.cpp b/src/protocols/LinuxDMABUF.cpp
index 897c98dc..74eeba2c 100644
--- a/src/protocols/LinuxDMABUF.cpp
+++ b/src/protocols/LinuxDMABUF.cpp
@@ -1,5 +1,6 @@
 #include "LinuxDMABUF.hpp"
 #include <algorithm>
+#include <cstring>
 #include <set>
 #include <tuple>
 #include "../helpers/MiscFunctions.hpp"
@@ -18,6 +19,30 @@
 
 using namespace Hyprutils::OS;
 
+// vmwgfx returns TTM-backed surface handles from drmPrimeFDToHandle, which
+// DRM_IOCTL_GEM_CLOSE cannot release. Fall back to the vmwgfx surface unref.
+#define DRM_VMW_UNREF_SURFACE 10
+
+struct drmVmwSurfaceArg {
+    int32_t  sid;
+    uint32_t handleType;
+};
+
+static int closeVmwGFXHandle(int fd, uint32_t handle) {
+    bool          isVmwgfx;
+    drmVersionPtr version;
+
+    version  = drmGetVersion(fd);
+    isVmwgfx = version && version->name && strncmp(version->name, "vmwgfx", version->name_len) == 0;
+    if (version)
+        drmFreeVersion(version);
+    if (!isVmwgfx)
+        return -1;
+
+    struct drmVmwSurfaceArg arg = {sc<int32_t>(handle), 0};
+    return drmCommandWrite(fd, DRM_VMW_UNREF_SURFACE, &arg, sizeof(arg));
+}
+
 static std::optional<dev_t> devIDFromFD(int fd) {
     struct stat stat;
     if (fstat(fd, &stat) != 0)
@@ -272,7 +297,8 @@ bool CLinuxDMABUFParamsResource::commence() {
             return false;
         }
 
-        if (drmCloseBufferHandle(PROTO::linuxDma->m_mainDeviceFD.get(), handle)) {
+        if (drmCloseBufferHandle(PROTO::linuxDma->m_mainDeviceFD.get(), handle) != 0 &&
+            closeVmwGFXHandle(PROTO::linuxDma->m_mainDeviceFD.get(), handle) != 0) {
             LOGM(Log::ERR, "Failed to close dmabuf handle");
             return false;
         }
